# ──────────────────────────────────────────────
# Angel One SmartAPI
# Get API key from: https://smartapi.angelbroking.com → Apps → Create App
# Get TOTP secret from: https://smartapi.angelbroking.com/enable-totp
# ──────────────────────────────────────────────
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_MPIN=              # Your 4-digit MPIN (set in the Angel One app)
ANGEL_TOTP_SECRET=

# ──────────────────────────────────────────────
# PostgreSQL (async)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:shanky8104@localhost:5432/trading_db

# ──────────────────────────────────────────────
# NIFTY 50 Index
# ──────────────────────────────────────────────
# Angel One NIFTY 50 token on NSE exchange (replaces Kite's 256265)
NIFTY_INSTRUMENT_TOKEN=26000
NIFTY_STRIKE_STEP=50

# ──────────────────────────────────────────────
# Candle & Signal Parameters
# ──────────────────────────────────────────────
SIGNAL_CONFIDENCE_THRESHOLD=0.7
CANDLE_INTERVALS=5,15

# ──────────────────────────────────────────────
# ML Models
# ──────────────────────────────────────────────
XGBOOST_MODEL_PATH=models/xgboost_model.pkl
LSTM_MODEL_PATH=models/lstm_model.pt
XGBOOST_WEIGHT=0.6
LSTM_WEIGHT=0.4

# ──────────────────────────────────────────────
# Market Hours (IST, 24h format)
# ──────────────────────────────────────────────
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# ──────────────────────────────────────────────
# NFO Options Tracking
# ──────────────────────────────────────────────
NFO_STRIKE_RANGE=10
NFO_ATM_UPDATE_MINUTES=5

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
